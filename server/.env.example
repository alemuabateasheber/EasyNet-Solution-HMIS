# Server-local environment template. Prefer the project-root .env for Docker Compose.
# Docker Compose passes SEED_ADMIN_PASSWORD into the API container from the root .env.
DATABASE_URL="postgresql://${POSTGRES_USER:-easynet}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB:-easynet}?schema=public"
JWT_SECRET="CHANGE_ME_TO_A_RANDOM_64_PLUS_CHARACTER_SECRET"
PORT=4000
CLIENT_ORIGIN="http://localhost:8080"
NODE_ENV="production"
SEED_ADMIN_PASSWORD="CHANGE_ME_TO_A_STRONG_ADMIN_PASSWORD"
SEED_DEMO_DATA="false"
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
TELEBIRR_API_URL=
TELEBIRR_WEBHOOK_SECRET=
CBE_BIRR_API_URL=
CBE_BIRR_WEBHOOK_SECRET=
QR_RENDER_URL=
