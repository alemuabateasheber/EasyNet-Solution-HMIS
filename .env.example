# EasyNet HIS local/production environment template
# Copy this file to .env and replace every CHANGE_ME value before starting Docker.
POSTGRES_USER=easynet
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_DATABASE_PASSWORD
POSTGRES_DB=easynet

JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_PLUS_CHARACTER_SECRET
PORT=4000
CLIENT_ORIGIN=http://localhost:8080
NODE_ENV=production
WEB_PORT=8080

# Create an administrator password with at least 12 characters for first-time seeding.
SEED_ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_ADMIN_PASSWORD
# Keep false for production. Set true only for an isolated demo/development database.
SEED_DEMO_DATA=false

# Optional SMS gateway. Expected JSON request: to, message, category, clientReference.
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=

# Optional Ethiopian mobile-money provider adapters. Supply credentials/URLs provided by your merchant contracts.
TELEBIRR_API_URL=
TELEBIRR_WEBHOOK_SECRET=
CBE_BIRR_API_URL=
CBE_BIRR_WEBHOOK_SECRET=

# Optional trusted QR rendering service. Leave blank when providers return a QR image themselves.
QR_RENDER_URL=
